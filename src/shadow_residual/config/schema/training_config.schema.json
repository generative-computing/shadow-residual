{
  "$defs": {
    "AdapterConfig": {
      "additionalProperties": false,
      "properties": {
        "target_modules": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "additionalProperties": {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              "type": "object"
            }
          ],
          "default": 32,
          "title": "Target Modules"
        },
        "alpha": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alpha"
        },
        "dropout": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dropout",
          "type": "number"
        },
        "bias": {
          "$ref": "#/$defs/Bias",
          "default": "none"
        },
        "task_type": {
          "const": "CAUSAL_LM",
          "default": "CAUSAL_LM",
          "title": "Task Type",
          "type": "string"
        },
        "last_context_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Context Token"
        },
        "last_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Token"
        },
        "share_moe_routing": {
          "default": true,
          "title": "Share Moe Routing",
          "type": "boolean"
        }
      },
      "title": "AdapterConfig",
      "type": "object"
    },
    "BatchConfig": {
      "additionalProperties": false,
      "properties": {
        "per_device_train": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Per Device Train",
          "type": "integer"
        },
        "gradient_accumulation": {
          "default": 16,
          "exclusiveMinimum": 0,
          "title": "Gradient Accumulation",
          "type": "integer"
        },
        "per_device_eval": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Per Device Eval",
          "type": "integer"
        },
        "gradient_checkpointing": {
          "default": true,
          "title": "Gradient Checkpointing",
          "type": "boolean"
        },
        "gradient_checkpointing_kwargs": {
          "additionalProperties": true,
          "title": "Gradient Checkpointing Kwargs",
          "type": "object"
        }
      },
      "title": "BatchConfig",
      "type": "object"
    },
    "Bias": {
      "enum": [
        "none",
        "all",
        "lora_only"
      ],
      "title": "Bias",
      "type": "string"
    },
    "DataConfig": {
      "additionalProperties": false,
      "properties": {
        "train_path": {
          "title": "Train Path",
          "type": "string"
        },
        "val_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Val Path"
        },
        "val_frac": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Val Frac"
        },
        "max_length": {
          "default": 8192,
          "exclusiveMinimum": 0,
          "title": "Max Length",
          "type": "integer"
        },
        "assistant_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assistant Marker"
        },
        "enable_thinking": {
          "default": false,
          "title": "Enable Thinking",
          "type": "boolean"
        },
        "instruction_as_user_message": {
          "default": false,
          "title": "Instruction As User Message",
          "type": "boolean"
        },
        "tool_formatting": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolFormatting"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool_task": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolTask"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vanilla_frac": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vanilla Frac"
        }
      },
      "required": [
        "train_path"
      ],
      "title": "DataConfig",
      "type": "object"
    },
    "GenerationConfig": {
      "additionalProperties": false,
      "description": "Post-training generation parameters.\n\nThe block is optional at the YAML level (``cfg.generation`` may be\n``None`` \u2014 see :class:`TrainingConfig`); when present, ``input_path``\nis the trigger field and is required. Used by the standalone\n``generate`` entry point and by ``train.py`` for post-training\nevaluation.",
      "properties": {
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "max_new_tokens": {
          "default": 256,
          "exclusiveMinimum": 0,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Top P",
          "type": "number"
        },
        "do_sample": {
          "default": false,
          "title": "Do Sample",
          "type": "boolean"
        },
        "batch_size": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Batch Size",
          "type": "integer"
        },
        "output_filename": {
          "default": "predictions.jsonl",
          "title": "Output Filename",
          "type": "string"
        },
        "debug_probability": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Debug Probability",
          "type": "number"
        }
      },
      "required": [
        "input_path"
      ],
      "title": "GenerationConfig",
      "type": "object"
    },
    "IntervalStrategy": {
      "enum": [
        "no",
        "epoch",
        "steps"
      ],
      "title": "IntervalStrategy",
      "type": "string"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "description": "HF model ID or local path, e.g. ibm-granite/granite-4.1-3b",
          "title": "Base",
          "type": "string"
        },
        "attn_implementation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attn Implementation"
        },
        "param_dtype": {
          "default": "bf16",
          "enum": [
            "bf16",
            "fp32"
          ],
          "title": "Param Dtype",
          "type": "string"
        }
      },
      "required": [
        "base"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "OptimizerConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "paged_adamw_8bit",
          "title": "Name",
          "type": "string"
        },
        "learning_rate": {
          "default": 0.0002,
          "exclusiveMinimum": 0,
          "title": "Learning Rate",
          "type": "number"
        },
        "weight_decay": {
          "default": 0.01,
          "minimum": 0.0,
          "title": "Weight Decay",
          "type": "number"
        },
        "max_grad_norm": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Max Grad Norm",
          "type": "number"
        }
      },
      "title": "OptimizerConfig",
      "type": "object"
    },
    "RuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "num_train_epochs": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Num Train Epochs",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "logging_steps": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Logging Steps",
          "type": "integer"
        },
        "dataloader_num_workers": {
          "default": 4,
          "minimum": 0,
          "title": "Dataloader Num Workers",
          "type": "integer"
        },
        "report_to": {
          "items": {
            "type": "string"
          },
          "title": "Report To",
          "type": "array"
        },
        "fsdp": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "additionalProperties": true,
              "type": "object"
            }
          ],
          "default": false,
          "title": "Fsdp"
        }
      },
      "title": "RuntimeConfig",
      "type": "object"
    },
    "SaveConfig": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "$ref": "#/$defs/IntervalStrategy",
          "default": "epoch"
        },
        "total_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 3,
          "title": "Total Limit"
        },
        "output_dir": {
          "title": "Output Dir",
          "type": "string"
        }
      },
      "required": [
        "output_dir"
      ],
      "title": "SaveConfig",
      "type": "object"
    },
    "SchedulerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/SchedulerType",
          "default": "cosine"
        },
        "warmup_ratio": {
          "default": 0.05,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Warmup Ratio",
          "type": "number"
        }
      },
      "title": "SchedulerConfig",
      "type": "object"
    },
    "SchedulerType": {
      "enum": [
        "cosine",
        "linear",
        "constant",
        "constant_with_warmup"
      ],
      "title": "SchedulerType",
      "type": "string"
    },
    "ToolFormatting": {
      "description": "How an SR adapter invoked as a tool relates to the chat template.\n\nGranite 4.2 (ChatML) only. In both modes the adapter produces the tool\nresponse and stops; it never writes the assistant answer (the base, or\nanother adapter, resumes after the tool turn).\n\n- EXTERNAL (bare ``--tool-formatting``): the serving environment owns the\n  template. It closes the base's tool-call turn, writes\n  ``<|im_start|>user\\n<tool_response>\\n`` and hands over; the adapter emits\n  only the tool-response payload and stops on EOS (``<|im_end|>``). The\n  environment then appends ``\\n</tool_response>\\n<|im_end|>\\n``.\n- AUTOREGRESSIVE: the adapter takes over right after the base's\n  ``</tool_call>`` and emits the whole tool-response turn,\n  ``\\n<|im_start|>user\\n<tool_response>\\n{payload}\\n</tool_response>\\n<|im_end|>``,\n  stopping on that ``<|im_end|>``.\n\nEach mode fixes the boundary markers; see ``docs/tool_formatting.md``.",
      "enum": [
        "autoregressive_tool_formatting",
        "external_tool_formatting"
      ],
      "title": "ToolFormatting",
      "type": "string"
    },
    "ToolTask": {
      "description": "Task source format converted to tool rows on load (``data.tool_task``).\n\nMirrors ``shadow_residual.training.tool_data.convert.TASKS``.",
      "enum": [
        "answerability",
        "guardian_core",
        "requirement_check",
        "query_clarification"
      ],
      "title": "ToolTask",
      "type": "string"
    },
    "TrainerConfig": {
      "additionalProperties": false,
      "description": "SFTTrainer-specific knobs that aren't part of the optimizer/batch story.",
      "properties": {
        "packing": {
          "default": false,
          "title": "Packing",
          "type": "boolean"
        },
        "debug_collator": {
          "default": false,
          "title": "Debug Collator",
          "type": "boolean"
        },
        "debug_probability": {
          "default": 0.001,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Debug Probability",
          "type": "number"
        }
      },
      "title": "TrainerConfig",
      "type": "object"
    },
    "ValidationConfig": {
      "additionalProperties": false,
      "description": "In-loop validation behavior (formerly `eval:`).",
      "properties": {
        "strategy": {
          "$ref": "#/$defs/IntervalStrategy",
          "default": "epoch"
        },
        "load_best_model_at_end": {
          "default": true,
          "title": "Load Best Model At End",
          "type": "boolean"
        },
        "metric_for_best_model": {
          "default": "eval_loss",
          "title": "Metric For Best Model",
          "type": "string"
        },
        "greater_is_better": {
          "default": false,
          "title": "Greater Is Better",
          "type": "boolean"
        },
        "early_stopping_patience": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 3,
          "title": "Early Stopping Patience"
        },
        "stop_on_nan": {
          "default": true,
          "title": "Stop On Nan",
          "type": "boolean"
        }
      },
      "title": "ValidationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root unified training config.",
  "properties": {
    "model": {
      "$ref": "#/$defs/ModelConfig"
    },
    "data": {
      "$ref": "#/$defs/DataConfig"
    },
    "adapter": {
      "$ref": "#/$defs/AdapterConfig"
    },
    "optimizer": {
      "$ref": "#/$defs/OptimizerConfig"
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig"
    },
    "batch": {
      "$ref": "#/$defs/BatchConfig"
    },
    "trainer": {
      "$ref": "#/$defs/TrainerConfig"
    },
    "validation": {
      "$ref": "#/$defs/ValidationConfig"
    },
    "save": {
      "$ref": "#/$defs/SaveConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenerationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "model",
    "data",
    "save"
  ],
  "title": "TrainingConfig",
  "type": "object"
}
